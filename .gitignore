# NOTE: an earlier version of this file listed itself, plus README.md,
# SETUP.md, PLAN.md and .env.example, which meant none of them were ever
# committed. A fresh clone therefore had no .gitignore at all and nothing
# stopping the next person from committing keys/sa.json. Do not re-add
# entries for tracked project files here.

# ---------------------------------------------------------------------------
# secrets: never commit credentials
# ---------------------------------------------------------------------------
docs/plans
keys/
.env
.env.*
!.env.example

# service account keys and similar, wherever they end up
*sa.json
*service-account*.json
*credentials*.json
*client_secret*.json
gha-creds-*.json
*.pem
*.p12
*.pfx
*.key

# ---------------------------------------------------------------------------
# python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# dbt build artifacts
# ---------------------------------------------------------------------------
target/
dbt_packages/
logs/
.user.yml

# ---------------------------------------------------------------------------
# local data and warehouses (ADR 0001: the Parquet raw zone is local and
# is never committed, regardless of how small it looks)
# ---------------------------------------------------------------------------
data/
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.parquet

# The published export (ADR-8). Regenerated wholesale by `make publish` from
# the warehouse, so it is a build artifact rather than a source, and it is
# large: mart_activity_by_h3 alone is a quarter of a million rows. The whole
# point of publishing is that it goes to a bucket, not into git.
published/

# ---------------------------------------------------------------------------
# os and editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

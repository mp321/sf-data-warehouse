# Copy this file to .env, fill it in, then load it with:
#   set -a; source .env; set +a
# (that one-liner exports every variable in the file)

# Your Google Cloud project id (not the display name)
GCP_PROJECT_ID=your-project-id

# Absolute path to your service account key. Absolute matters because
# dbt runs from the dbt/ subfolder.
GOOGLE_APPLICATION_CREDENTIALS=/full/path/to/sf-data-warehouse/keys/sa.json

# Optional overrides
BQ_RAW_DATASET=raw_datasf
BQ_LOCATION=US

# Where the two Parquet zones live (ADR-9). Unset means local: data/raw and
# data/derived, which is what a fresh clone and all of CI use.
#
# Set these and the zones live in a bucket instead, for reading and for writing.
# `ingest.py` appends Parquet straight to the bucket, `spatial.py` writes the
# derived zone there, `load.py --target duckdb` reads both through gcsfs, and
# `load.py --target bigquery` creates external tables over them so BigQuery
# stores no raw bytes at all.
#
# A run writes to one zone or the other and never to both, so a remote run does
# not also update data/raw. ADR-9 rejected keeping a local copy beside the
# bucket: two copies with nothing to detect divergence is the failure this
# project had just finished fixing in the derived zone. Set both variables or
# neither unless you specifically want a remote raw zone with a local derived
# one, which works and which check_derived.py will keep honest.
#
# --full-refresh does not work against a bucket and says so. It swaps a whole
# tree, GCS has no atomic rename, and a half-done swap loses the raw zone.
#
# The bucket needs the service account to have roles/storage.objectAdmin on it,
# and nothing wider. Note that role deliberately does not include
# storage.buckets.get, so code that calls client.get_bucket() will 403 while
# every object read and write works.
#
# RAW_ZONE_DIR and DERIVED_ZONE_DIR override these when both are set, which is
# how `make ci-build` stays local and credential-free in a shell that has
# sourced this file. Do not "fix" that precedence.
GCS_BUCKET=
RAW_ZONE_URI=
DERIVED_ZONE_URI=

# Optional: free app token from https://data.sfgov.org/profile/edit/developer_settings
# Not required, but lifts Socrata rate limits.
SOCRATA_APP_TOKEN=

# Optional: Census API key from https://api.census.gov/data/key_signup.html
#
# NOT needed for the pipeline. The population denominator comes from the
# Census TIGERweb service, which needs no key (ADR-7). This is only for
# ingestion/census.py's fetch_acs_population(), which nothing calls and which
# exists so the 2020 Decennial counts can be compared against a current ACS
# estimate by whoever has a key.
CENSUS_API_KEY=

# Optional: remote destination for `make publish` (ADR-8). The local export to
# published/ works with none of these set, which is the point.
#
# Cloudflare R2. Also needs `pip install boto3`, which is deliberately not a
# project dependency because the local export does not use it.
#   make publish PUBLISH_DEST=r2://my-bucket/sf
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# GCS uses GOOGLE_APPLICATION_CREDENTIALS above.
#   make publish PUBLISH_DEST=gs://my-bucket/sf
